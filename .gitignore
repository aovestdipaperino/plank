/target
*.gguf
.claude/
# per-project /config settings (src/config.rs saves them here)
.plank/
# ...except the multi-provider test fixtures, where the .plank/ directories ARE
# the test: they carry the sub-agent definitions those sessions exercise. They
# hold no credentials — a definition names the key's env var, never the key.
!multi-provider-tests/*/.plank/
!multi-provider-tests/*/.plank/**
# `local/` at any depth, not just the root: a scratch directory next to any
# working tree — including the multi-provider test sessions — stays untracked.
local/
/vault/
# local launch scripts may embed API keys (e.g. scripts/plank-z.sh)
/scripts/
docs/superpowers/

# generated illustrations: the image-generation cache and the images it renders
/cache/
/generated-illustrations/

# macOS Finder metadata
.DS_Store
.wrangler/
.tokensave/
.vscode/
